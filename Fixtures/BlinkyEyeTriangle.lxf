{
	"label": "BlinkyEyeTriangle",
	"tag": "Triangle",
	"parameters": {
		"rotate": {
			"type": "int",
			"default": 0,
			"label": "Rotate",
			"description": "Rotate degrees so the plug of the triangle is at this position"
		}
	},
	"transforms": [
		{	"roll": "$rotate + 180" }, // rotate the triangle itself
		{ 
			// components list a triangle with an edge-length of 1, which is 0.
			"scale": 0.5842
		}
	],
	"components": [


